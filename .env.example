# Path to your PowerTrader data directory.
# This folder will hold state/, pt_config.json, and exchange_api_keys.json.
# Copy this file to .env and set the path for your OS:
#
#   Mac / Linux:  POWERTRADER_ROOT=/home/yourname/powertrader
#   Windows:      POWERTRADER_ROOT=C:/Users/yourname/powertrader
#
POWERTRADER_ROOT=/home/yourname/powertrader
